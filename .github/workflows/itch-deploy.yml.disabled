name: itch.io deploy

# Manual-trigger only. Never `on: push` or `on: pull_request` — we do NOT want
# every merge to publish a build to itch.io. The user runs this from the
# Actions tab (or `gh workflow run itch-deploy.yml`) when they want to ship.
#
# Prerequisite: `ITCH_API_KEY` secret must be set on the repo:
#   gh secret set ITCH_API_KEY --repo SohailShahM/Cloudy-Ninja
# Get the key from https://itch.io/user/settings/api-keys (see docs/itch-deploy.md).
on:
  workflow_dispatch:
    inputs:
      channel:
        description: 'itch.io channel (e.g. desktop, windows, linux, mac). Determines which platform metadata itch attaches to the upload.'
        required: true
        default: 'desktop'
        type: string
      version-tag:
        description: 'Version label shown on itch.io (e.g. 0.1.0-alpha). Defaults to the short commit SHA when empty.'
        required: false
        default: ''
        type: string

# Only one deploy at a time. If a second dispatch lands while one is running,
# queue it rather than cancelling — we never want to half-upload a build.
concurrency:
  group: itch-deploy
  cancel-in-progress: false

jobs:
  deploy:
    name: Build JAR and push to itch.io
    runs-on: ubuntu-latest
    # No `permissions:` block needed — butler authenticates via ITCH_API_KEY,
    # not the GITHUB_TOKEN. Default read-only contents perms are fine.

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Verify ITCH_API_KEY is set
        env:
          ITCH_API_KEY: ${{ secrets.ITCH_API_KEY }}
        run: |
          if [ -z "$ITCH_API_KEY" ]; then
            echo "ERROR: ITCH_API_KEY secret is not set on this repo."
            echo "Set it with: gh secret set ITCH_API_KEY --repo SohailShahM/Cloudy-Ninja"
            echo "See docs/itch-deploy.md for how to generate the key."
            exit 1
          fi
          echo "ITCH_API_KEY is present (length=${#ITCH_API_KEY})."

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: gradle

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew

      - name: Build desktop JAR
        # The desktop module is `:lwjgl3` (not `:desktop`). `:lwjgl3:dist` is
        # an alias for `:lwjgl3:jar` (see lwjgl3/build.gradle's `dist` task)
        # kept for gdx-setup compatibility. Output lands at
        # `lwjgl3/build/libs/Cloudy Ninja-<projectVersion>.jar`.
        run: ./gradlew :lwjgl3:dist

      - name: Locate built JAR
        id: locate
        run: |
          set -e
          JAR=$(ls lwjgl3/build/libs/*.jar | head -n 1)
          if [ -z "$JAR" ] || [ ! -f "$JAR" ]; then
            echo "ERROR: No JAR found in lwjgl3/build/libs/."
            ls -la lwjgl3/build/libs/ || true
            exit 1
          fi
          echo "Found JAR: $JAR"
          echo "jar=$JAR" >> "$GITHUB_OUTPUT"

      - name: Resolve version tag
        id: version
        env:
          INPUT_TAG: ${{ inputs.version-tag }}
        run: |
          set -e
          if [ -n "$INPUT_TAG" ]; then
            TAG="$INPUT_TAG"
          else
            TAG=$(git rev-parse --short HEAD)
          fi
          echo "Version tag: $TAG"
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"

      - name: Deploy to itch.io
        env:
          BUTLER_API_KEY: ${{ secrets.ITCH_API_KEY }}
          ITCH_JAR: ${{ steps.locate.outputs.jar }}
          ITCH_CHANNEL: ${{ inputs.channel }}
          ITCH_VERSION_TAG: ${{ steps.version.outputs.tag }}
        run: bash scripts/deploy-itch.sh

      - name: Upload built JAR as artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: cloudy-ninja-jar-${{ steps.version.outputs.tag }}
          path: ${{ steps.locate.outputs.jar }}
          if-no-files-found: error
